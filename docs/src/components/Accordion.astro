---
// ponytail: native <details>/<summary>, no JS. Same `name` on several = only one open at a time.
// Colors use light-dark(): they follow `color-scheme` on <html>, which the theme toggle must set.
// `badge` takes Starlight's own <Badge> props (text, variant, size), passed through as-is.
import { Badge } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';
interface Props { title: string; badge?: ComponentProps<typeof Badge>; open?: boolean; name?: string }
const { title, badge, open = false, name } = Astro.props;
---
<details class="accordion" open={open} name={name}>
  <summary>{title} {badge && <Badge {...badge} />}</summary>
  <div class="panel"><slot /></div>
</details>

<style>
  summary {
    background-color: light-dark(#eee, #333);
    color: light-dark(#444, #ddd);
    cursor: pointer;
    padding: 18px;
    list-style: none;
    transition: 0.4s;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover,
  [open] > summary { background-color: light-dark(var(--sl-color-text-accent), var(--sl-color-text-accent)); }
  details {
    border-radius: 8px;
    overflow: hidden;
    /* undo Starlight's markdown <details> left border + indent; keep its leading caret (rotates on open) */
    border: none;
    padding: 0;
  }
  summary { margin: 0; }
  /* gap between stacked entries (Starlight's default sibling spacing is 1rem) */
  details + details { margin-top: 0.25rem; }
  .panel {
    padding: 0 18px 1rem;
    background-color: light-dark(white, #1e1e1e);
    color: light-dark(#222, #ddd);
  }
</style>